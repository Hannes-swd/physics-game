{
  "_info": [
    "Werkstatt - Tiere: Arten, Verhalten und Vorkommen je Biom. Mehr: docs/24-Tiere.md",
    "Tiere erscheinen immer in der Nähe des Spielers, je Biom mit den Arten unter \"biomes\", und verschwinden ganz, sobald",
    "sie weiter weg sind als \"visible\" (mal Sichtweite aus den Einstellungen). Kleine Tiere sieht man nur nah, große auf",
    "freiem Feld weit, Vögel am Himmel und Gämsen am Berg sehr weit. Im Blickfeld erscheinen sie erst in der Ferne.",
    "Die Modelle liegen in assets/animals (glTF-Binärdateien mit Skelett und Abläufen, Lizenz CC0, siehe LICENSE.md).",
    "\"bird\" ist eine eingebaute Low-Poly-Vogelform (Körper, schlagende Flügel, Schnabel) in den Farben unter \"colors\".",
    "Änderungen gelten nach 'animals reload' sofort."
  ],
  "_keys": {
    "enabled":             "false: keine Tiere",
    "spawn.interval":      "s zwischen zwei Versuchen, eine Gruppe erscheinen zu lassen (je Versuch eine Art)",
    "spawn.max_animals":   "höchstens so viele Tiere gleichzeitig",
    "spawn.min_distance":  "nie näher am Spieler erscheinen (m)",
    "spawn.hidden_share":  "im Blickfeld erst ab diesem Anteil von visible erscheinen (sonst nur hinter dem Spieler)",
    "species[].model":     "Datei in assets/animals oder \"bird\"",
    "species[].height":    "ganze Höhe des Modells (m), bei \"bird\" die Spannweite",
    "species[].tint":      "Material des Modells -> andere Farbe [r, g, b] (linear 0..1 wie im Modell). Ein Modell, viele Tiere",
    "species[].foot":      "Knochen, an dem gemessen wird, wie schnell die Beine laufen (damit die Hufe nicht rutschen)",
    "species[].clips":     "Abläufe im Modell: idle (Liste, zufällig gewechselt), walk, run, fly",
    "species[].speed":     "[gehen, rennen] in m/s",
    "species[].turn":      "Wendigkeit (rad/s)",
    "species[].group":     "Gruppengröße [von, bis]: 1 = Einzelgänger, mehr = Rudel/Herde (bleibt zusammen, flieht gemeinsam)",
    "species[].spread":    "so weit (m) stehen die Tiere einer Gruppe auseinander",
    "species[].wander":    "so weit (m) zieht die Gruppe um ihren Platz herum",
    "species[].behavior":  "shy = schaut ab alert (m) her, flieht ab flee (m); calm = weicht erst ab flee aus; curious = hält Abstand keep [nah, fern] und umkreist, flieht ab flee; small = flitzt ab flee kurz weg",
    "species[].takeoff":   "true: flieht fliegend (mit Flügeln in colors.wing, Spannweite wingspan) und landet später wieder",
    "species[].visible":   "so weit (m) bleibt das Tier, dahinter verschwindet es",
    "species[].active":    "always, day oder night: erscheint nur dann (außerhalb seiner Zeit verschwindet es, wenn man nicht hinsieht)",
    "species[].motion":    "ground = läuft; soar = kreist (Greifvögel, Möwen); flock = Schwarm; flutter = flattert (Fledermaus)",
    "species[].slope":     "erscheint nur an so steilen Stellen [von, bis] (1 - Normale.y; 0 eben, 0.3 = 46°)",
    "species[].move_slope":"so steil darf es laufen",
    "species[].altitude":  "erscheint nur in dieser Höhe [von, bis] (m)",
    "species[].water":     "true: darf ins flache Wasser",
    "species[].fly_height":"Flughöhe über dem Boden [von, bis] (m); circle = Kreise [von, bis] (m); fly_speed (m/s)",
    "species[].colors":    "\"bird\": body, wing, beak; mit takeoff: wing",
    "biomes":              "je Biom (Id aus biomes.json): Art -> so viele Gruppen gleichzeitig in Sichtweite (Bruchteile: in manchen Gegenden eine mehr)"
  },
  "version": 1,
  "enabled": true,
